{
  "name": "nuxt-multi-app",
  "version": "0.0.0",
  "description": "Serve several independent Nuxt applications from one dev server and one production process.",
  "homepage": "https://github.com/IlyaSemenov/nuxt-multi-app#readme",
  "bugs": "https://github.com/IlyaSemenov/nuxt-multi-app/issues",
  "license": "MIT",
  "author": "Ilya Semenov",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IlyaSemenov/nuxt-multi-app.git"
  },
  "files": [
    "README.md",
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/module.d.mts",
      "import": "./dist/module.mjs"
    },
    "./runtime": {
      "types": "./dist/runtime/types.d.ts",
      "import": "./dist/runtime/types.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "nuxt-module-build build && publint",
    "lint": "oxlint --fix && oxfmt",
    "lint:check": "oxlint && oxfmt --check",
    "prepare": "lefthook install",
    "prepublishOnly": "bun run build",
    "test": "bun test src",
    "test:nuxt": "bun run build && bun tests/nuxt/run.ts 4.5.2",
    "types": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json"
  },
  "dependencies": {
    "@nuxt/kit": "~4.5.2",
    "@types/node": "^22.20.0",
    "crossws": "^0.3.5",
    "esbuild": "^0.28.2",
    "h3": "^1.15.4",
    "magic-string": "^1.3.1",
    "semver": "^7.7.2"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@nuxt/cli": "^3.37.0",
    "@nuxt/module-builder": "^1.0.3",
    "@nuxt/nitro-server": "~4.5.2",
    "@playwright/test": "1.58.2",
    "@tsconfig/bun": "^1.0.10",
    "@types/bun": "^1.4.0",
    "@types/semver": "^7.7.1",
    "nuxt": "~4.5.2",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "publint": "^0.3.22",
    "typescript": "^5.9.3"
  },
  "peerDependencies": {
    "nuxt": "~4.5.2"
  },
  "engines": {
    "node": "^22.19.0 || ^24.11.0 || >=26.0.0"
  },
  "packageManager": "bun@1.4.2"
}
